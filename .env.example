# Copy this file to ".env" and fill in your own values.
# ".env" is in .gitignore: never commit it, never paste it into the team chat.
# This file contains variable NAMES only, no values.

# Groq: STT (Whisper) and LLM script generation share one key
DEEPGRAM_API_KEY=
GLADIA_API_KEY=
GROQ_API_KEY=
GROQ_STT_MODEL=
GROQ_LLM_MODEL=
GROQ_LLM_FALLBACK_MODEL_1=
GROQ_LLM_FALLBACK_MODEL_2=

# App environment: dev or prod
APP_ENV=dev

# Supabase (DB + Storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Temporary dev user (UUID from Supabase Auth on psc-dev), only used when APP_ENV=dev
# TODO(auth): remove when real auth is merged
DEV_USER_ID=
# Second test user, only read by integration tests (uv run pytest -m integration)
DEV2_USER_ID=

# Local moderation (Ollama + Llama-Guard), not used yet
# OLLAMA_HOST=
# GUARD_MODEL=