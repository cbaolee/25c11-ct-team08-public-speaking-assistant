# Copy this file to ".env" and fill in your own values.
# ".env" is in .gitignore: never commit it, never paste it into the team chat.
# This file contains variable NAMES only, no values.
#
# REQUIRED: the server refuses to start when one of these is empty
# (see missing_required_settings in src/app/config.py).

# API keys: one or more per service, separated by commas, no spaces needed: KEY1,KEY2
# One key is fine too: GROQ_API_KEYS=KEY1
# When a key runs out of quota (HTTP 429/402) the server switches to the next one by itself and
# retries it after a cooldown (app_constants.toml [api_keys]); a refused key (401/403) is skipped
# until restart. The old single-key names (DEEPGRAM_API_KEY...) are no longer read.

# Bao, Dat, Mai, Tuan, Hoa, Vi

# --- Required: speech-to-text (all Deepgram keys first, then Gladia) ---
DEEPGRAM_API_KEYS=
GLADIA_API_KEYS=

# --- Required: Groq LLM for script generation (all keys for one model, then the fallback model) ---
GROQ_API_KEYS=

# --- Optional: Groq model chain (primary -> fallback 1 -> fallback 2) ---
# Leave all three empty to use the defaults:
#   openai/gpt-oss-120b -> qwen/qwen3.8-27b -> openai/gpt-oss-20b
# If you set one, set all three: the template engine only uses the models listed here.
GROQ_LLM_MODEL=
GROQ_LLM_FALLBACK_MODEL_1=
GROQ_LLM_FALLBACK_MODEL_2=

# App environment: dev or prod (default dev)
APP_ENV=dev

# --- Supabase (DB + Storage) ---
# Required when APP_ENV is not dev. In dev, leave SUPABASE_URL empty to use in-memory storage
# (data is lost on restart); if you set SUPABASE_URL, SUPABASE_SERVICE_KEY is required too.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Accounts: Supabase Auth of the same project (sign up / log in through /api/auth/*).
# Without SUPABASE_URL (dev only) accounts are kept in RAM and lost on restart.

# Two test users on psc-dev, only read by integration tests (uv run pytest -m integration)
DEV_USER_ID=
DEV2_USER_ID=

# Local moderation (Ollama + Llama-Guard), not used yet
# OLLAMA_HOST=
# GUARD_MODEL=

# AI Coach Note uses Cerebras; model IDs and quotas must be checked on Cerebras Cloud.
# Coach note does not use Groq.
CEREBRAS_API_KEYS=
CEREBRAS_MODEL=
CEREBRAS_FALLBACK_MODEL_1=
