# Copy this file to ".env" and fill in your own values.
# ".env" is in .gitignore: never commit it, never paste it into the team chat.
# This file contains variable NAMES only, no values.

# Groq: STT (Whisper) and LLM script generation share one key
DEEPGRAM_API_KEY=
GLADIA_API_KEY=
GROQ_API_KEY=
GROQ_STT_MODEL=
GROQ_LLM_MODEL=
GROQ_LLM_FALLBACK_MODEL_1=
GROQ_LLM_FALLBACK_MODEL_2=

# App environment: dev or prod
APP_ENV=dev

# Supabase (DB + Storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Local moderation (Ollama + Llama-Guard), not used yet
# OLLAMA_HOST=
# GUARD_MODEL=