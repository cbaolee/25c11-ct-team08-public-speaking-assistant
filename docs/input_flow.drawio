        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;themeVariables&#39;: {&#39;edgeLabelBackground&#39;: &#39;transparent&#39;}}}%%\nflowchart TD\n    %% Define UI Node Styles\n    classDef screen fill:#1e293b,stroke:#3b82f6,stroke-width:2px,color:#ffffff\n    classDef state fill:#334155,stroke:#f59e0b,stroke-width:2px,stroke-dasharray: 5 5,color:#ffffff\n    classDef error fill:#450a0a,stroke:#ef4444,stroke-width:2px,color:#fca5a5\n    classDef success fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#a7f3d0\n    classDef decision fill:#0f172a,stroke:#94a3b8,stroke-width:2px,color:#ffffff\n\n    %% ================= DASHBOARD &amp; NAVIGATION =================\n    Dash[\&quot;Main Dashboard Screen&lt;br/&gt;Options: Generate Script | Practice Voice | History\&quot;]:::screen\n    Dash --&gt;|Click Profile| Profile[\&quot;Profile Screen&lt;br/&gt;(Update user info &amp; Record 30s Baseline Voice)\&quot;]:::screen\n    Dash --&gt;|Click History| History[\&quot;Practice History Screen&lt;br/&gt;(List of saved Audio Records &amp; Score charts)\&quot;]:::screen\n\n    %% ================= MODULE 1: SCRIPT GENERATING (UI) =================\n    Dash --&gt;|Click Generate Script| U1\n\n    subgraph FUNC1 [\&quot;MODULE 1: SCRIPT GENERATION UI FLOW\&quot;]\n        direction TB\n        U1[\&quot;Script Input Screen&lt;br/&gt;- Select Topic Dropdown&lt;br/&gt;- Drag &amp; Drop PDF File or Enter Text\&quot;]:::screen\n        \n        U1 --&gt;|Click Generate Button| ING1{\&quot;File Validation&lt;br/&gt;(UI Sanity Gate)\&quot;}:::decision\n        \n        ING1 --&gt;|Invalid Format / Oversized / Password Protected| ERR1[\&quot;UI Error State: Red Border &amp; Inline Message&lt;br/&gt;&#39;Invalid file format, size exceeded, or password-protected!&#39;\&quot;]:::error\n        ERR1 --&gt;|User selects another file| U1\n        \n        ING1 --&gt;|Valid File| LOAD_EXTRACT[\&quot;UI Loading State: Skeleton Loader&lt;br/&gt;&#39;Extracting text &amp; verifying content safety...&#39;\&quot;]:::state\n        \n        LOAD_EXTRACT --&gt; VAL_CHECK{\&quot;Content Moderation&lt;br/&gt;(Profanity / Harmful?)\&quot;}:::decision\n        \n        VAL_CHECK --&gt;|Policy Violation| ERR2[\&quot;UI Safety Alert Modal:&lt;br/&gt;&#39;Content contains inappropriate or restricted language.&lt;br/&gt;Please revise your input material!&#39;\&quot;]:::error\n        ERR2 --&gt;|Click Acknowledge &amp; Edit| U1\n        \n        VAL_CHECK --&gt;|Safe Content| LOAD_GEN[\&quot;UI Loading State: Progress Bar&lt;br/&gt;&#39;Generating English MC script...&#39;\&quot;]:::state\n        \n        LOAD_GEN --&gt; OUT1[\&quot;Reference Script Screen&lt;br/&gt;- Text Editor displaying generated English script&lt;br/&gt;- Highlighted keywords&lt;br/&gt;- Buttons: Copy Text | Download | Regenerate\&quot;]:::success\n    end\n\n    OUT1 --&gt;|Click Back to Dashboard| Dash\n\n    %% ================= MODULE 2: EVALUATE VOICE PRACTICE (UI) =================\n    Dash --&gt;|Click Evaluate Voice| U2\n    OUT1 -.-&gt;|Click Practice with this Script| U2\n\n    subgraph FUNC2 [\&quot;MODULE 2: VOICE PRACTICE &amp; EVALUATION UI FLOW\&quot;]\n        direction TB\n        U2[\&quot;Voice Studio Screen (Record / Upload)&lt;br/&gt;- Left Panel: Reference Script Display&lt;br/&gt;- Right Panel: Direct Mic Recording OR Upload Audio File\&quot;]:::screen\n        \n        U2 --&gt;|Finish Recording / Upload Audio &amp; Click Evaluate| LOAD_PRE[\&quot;UI Loading State (Step 1/2)&lt;br/&gt;&#39;Compressing &amp; normalizing audio...&#39;\&quot;]:::state\n        \n        LOAD_PRE --&gt; LOAD_ANA[\&quot;UI Analyzing State (Step 2/2)&lt;br/&gt;&#39;Transcribing speech, measuring pacing (WPM) &amp; prosody...&#39;\&quot;]:::state\n        \n        LOAD_ANA --&gt; OUT2[\&quot;Evaluation Report Screen&lt;br/&gt;1. Overall Score (Compared against 30s Baseline)&lt;br/&gt;2. Transcript View: Mispronounced / missing words highlighted in red&lt;br/&gt;3. Visual Charts: Pacing (WPM), Pauses, Pitch (F0) &amp; Volume (dB)&lt;br/&gt;4. Audio Player (Playback recorded voice)\&quot;]:::screen\n        \n        OUT2 --&gt; SAVE_TOAST[\&quot;UI Toast Notification:&lt;br/&gt;&#39;Audio Record &amp; Evaluation Report automatically saved to History&#39;\&quot;]:::success\n    end\n\n    SAVE_TOAST --&gt;|Click Re-record / Upload Another| U2\n    SAVE_TOAST --&gt;|Click View History| History\n    SAVE_TOAST --&gt;|Click Back to Dashboard| Dash&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="6U0zkVIXLJNiaiAlb-0J-100">
