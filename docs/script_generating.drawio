        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    classDef user fill:#e1bee7,stroke:#8e24aa,stroke-width:2px,color:#000\n    classDef process fill:#bbdefb,stroke:#1976d2,stroke-width:2px,color:#000\n    classDef condition fill:#ffe082,stroke:#f57f17,stroke-width:2px,color:#000\n    classDef error fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px,color:#000\n    classDef output fill:#c8e6c9,stroke:#388e3c,stroke-width:2px,color:#000\n    classDef db fill:#bcaaa4,stroke:#5d4037,stroke-width:2px,color:#000\n\n    %% ==========================================\n    %% CHỨC NĂNG 1: SCRIPT GENERATING\n    %% ==========================================\n    subgraph FUNC1 [CHỨC NĂNG 1: SCRIPT GENERATING]\n        direction TB\n        \n        U1([Người dùng: Chọn Topic &amp; Upload PDF/Text]):::user --&gt; ING1{Chốt 1: Sanity Gate&lt;br/&gt;(Check File, Size, Pass)}:::condition\n        \n        ING1 -- Lỗi --&gt; ERR1[Báo lỗi UI / Từ chối]:::error\n        ING1 -- Hợp lệ --&gt; ING2[Chốt 2 &amp; 3: Định tuyến trang &amp; Trích xuất&lt;br/&gt;PyMuPDF4LLM / RapidOCR]:::process\n        ING2 --&gt; ING3[Chốt 4: Đóng gói JSON&lt;br/&gt;Markdown &amp; Từ khóa]:::process\n        \n        ING3 --&gt; VAL1{Lọc vòng 1: Local Regex &amp; Profanity&lt;br/&gt;Chặn từ cấm lộ liễu}:::condition\n        VAL1 -- Dính từ cấm --&gt; ERR2[Chặn &amp; Cảnh báo an toàn]:::error\n        VAL1 -- Sạch --&gt; VAL2{Lọc vòng 2: Local AI Thẩm phán&lt;br/&gt;Llama-Guard-3-1B via Ollama}:::condition\n        VAL2 -- Độc hại / Bạo lực --&gt; ERR2\n        \n        VAL2 -- An toàn --&gt; GEN_ROUTER{Kiểm tra Chủ đề&lt;br/&gt;(Có Template sẵn?)}:::condition\n        \n        GEN_ROUTER -- Có Template --&gt; GEN1[Nhánh 1: NLP Interpolation&lt;br/&gt;Điền từ khóa vào Template (0 token)]:::process\n        GEN_ROUTER -- Không Template --&gt; GEN2[Nhánh 2: Chuỗi Fallback API&lt;br/&gt;gpt-120b -&gt; qwen-27b -&gt; gpt-20b]:::process\n        \n        GEN1 --&gt; OUT1[[Kịch bản tiếng Anh (Reference Script)]]:::output\n        GEN2 --&gt; OUT1\n    end\n\n    %% ==========================================\n    %% CHỨC NĂNG 2: EVALUATE VOICE PRACTICE\n    %% ==========================================\n    subgraph FUNC2 [CHỨC NĂNG 2: EVALUATE VOICE PRACTICE]\n        direction TB\n        \n        U2([Người dùng: Thu âm theo kịch bản]):::user --&gt; PRE1[Frontend Nén Audio&lt;br/&gt;Opus/WebM 32kbps]:::process\n        PRE1 --&gt; PRE2[Backend: FFmpeg Xử lý&lt;br/&gt;Hạ 16kHz, Mono, Cân bằng âm]:::process\n        \n        PRE2 --&gt; STT_ROUTER{STT One-Shot API&lt;br/&gt;(Lấy Text + Timestamps)}:::condition\n        STT_ROUTER -- Ưu tiên 1 (Nhanh) --&gt; STT1[GroqCloud: whisper-large-v3]:::process\n        STT_ROUTER -- Ưu tiên 2 (Mở rộng) --&gt; STT2[Deepgram / Gladia API]:::process\n        STT_ROUTER -- Ưu tiên 3 (Dự phòng) --&gt; STT3[Local: Faster-Whisper]:::process\n        \n        STT1 &amp; STT2 &amp; STT3 --&gt; DATA_SPLIT[Tách 2 luồng dữ liệu JSON]:::process\n        \n        %% Luồng phân tích\n        DATA_SPLIT -- \&quot;Text Transcript\&quot; --&gt; ANA1[So khớp chuỗi (String Matching)&lt;br/&gt;Levenshtein -&gt; CMU Phonetic -&gt; Semantic]:::process\n        DATA_SPLIT -- \&quot;Word Timestamps\&quot; --&gt; ANA2[Phân tích Nhịp điệu (Pacing)&lt;br/&gt;Tính WPM, Pauses, AR, PTR]:::process\n        \n        PRE2 -- \&quot;Sóng âm Audio\&quot; --&gt; ANA3[Xác thực VAD Cục bộ&lt;br/&gt;Silero VAD]:::process\n        PRE2 -- \&quot;Sóng âm Audio\&quot; --&gt; ANA4[Phân tích Âm điệu (Prosody)&lt;br/&gt;Praat/Parselmouth tính F0, dB]:::process\n        \n        ANA3 -- \&quot;Khoảng lặng thật\&quot; --&gt; ANA2\n        \n        ANA1 &amp; ANA2 &amp; ANA4 --&gt; SCORE[Tổng hợp Điểm số&lt;br/&gt;So sánh với Baseline 30s]:::process\n        \n        SCORE --&gt; DB[(Cơ sở dữ liệu Supabase&lt;br/&gt;Lưu JSONB Metrics &amp; Audio URL)]:::db\n        SCORE --&gt; OUT2[[Hiển thị Báo cáo UI&lt;br/&gt;Điểm số, Lỗi bôi đỏ, Biểu đồ WPM]]:::output\n    end\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="rairXctOSM5yV1_XqWTF-1">
